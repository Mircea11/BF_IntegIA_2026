# =====================================================================
# GABARIT — copiez ce fichier en ".env" puis remplissez les valeurs.
#   PowerShell : Copy-Item .env.example .env
#   Git Bash   : cp .env.example .env
# Le vrai ".env" ne doit JAMAIS être partagé ni committé (voir .gitignore).
# =====================================================================

# --- PostgreSQL (base interne de n8n) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=changez_moi_mot_de_passe_fort
POSTGRES_DB=n8n

# --- n8n ---
# Clé de chiffrement des credentials — PROPRE À CHAQUE INSTANCE.
# Générez la VÔTRE (ne réutilisez jamais celle de quelqu'un d'autre) :
#   Git Bash / Linux / macOS : openssl rand -hex 16
#   PowerShell               : [guid]::NewGuid().ToString('N')
# Une fois définie, ne la changez plus : sinon les credentials déjà
# enregistrés deviennent illisibles.
N8N_ENCRYPTION_KEY=
